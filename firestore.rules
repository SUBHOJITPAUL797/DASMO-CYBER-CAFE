rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             (request.auth.token.email == "suvojitpal797@gmail.com" || request.auth.token.email == "subhojitpaul26042004@gmail.com") && 
             request.auth.token.email_verified == true;
    }

    // Validate booking ID characters and length to guard against resource exhaustion/DDoS
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Settings collection containing the catalog and booking config
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Individual bookings
    match /bookings/{bookingId} {
      allow read: if isAdmin();
      
      allow create: if isValidId(bookingId)
                   && request.resource.data.id == bookingId
                   && request.resource.data.name is string 
                   && request.resource.data.name.size() <= 150
                   && request.resource.data.mobile is string
                   && request.resource.data.mobile.size() <= 30
                   && request.resource.data.work is string
                   && request.resource.data.work.size() <= 250
                   && request.resource.data.date is string
                   && request.resource.data.date.size() <= 30
                   && request.resource.data.time is string
                   && request.resource.data.time.size() <= 100
                   && request.resource.data.createdAt is string
                   && request.resource.data.createdAt.size() <= 100
                   // Server-side relational tie: Ensure the booking ID is atomically registered in user's rate limits
                   && getAfter(/databases/$(database)/documents/client_limits/$(request.resource.data.mobile)).data.bookingIds.hasAll([bookingId]);

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Client limits tracking document to enforce rate limiting
    match /client_limits/{phoneNumber} {
      allow read: if true;
      allow write: if isAdmin() || (
        isValidId(phoneNumber)
        && request.resource.data.phoneNumber == phoneNumber
        && request.resource.data.bookingIds is list
        && request.resource.data.bookingIds.size() <= get(/databases/$(database)/documents/settings/catalog).data.bookingConfig.limitPerPhone
        // Server-side security enforcer: Regular clients are strictly prohibited from clearing or deleting 
        // existing booking references from their tracking list. Only administrators can process or clear slots.
        && (resource == null || request.resource.data.bookingIds.hasAll(resource.data.bookingIds))
      );
    }
  }
}
